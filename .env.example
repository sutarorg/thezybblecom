# ============================================================================
# Zybble — environment template. Copy to .env.local and fill in your values.
# NEVER commit real keys. See README.md for the full setup walkthrough.
# ============================================================================

# ---- Browser-safe (exposed to the Vite bundle — publishable only) ----------
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# ---- Search provider (server-side only; never prefix with VITE_) ------------
# On Vercel, set this in Project Settings → Environment Variables and redeploy.
# For local/non-Vercel Edge fallback, also set it with `supabase secrets set`.
SERPAPI_API_KEY=PASTE_YOUR_ROTATED_SERPAPI_KEY_HERE

# ---- Supabase Edge Function secrets (server-side only, set via CLI) --------
# Stored as Edge Function secrets: `supabase secrets set NAME=value`
# The runtime injects SUPABASE_URL and SUPABASE_SECRET_KEYS automatically.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_signing_secret
RAZORPAY_PLAN_GROWTH_ID=plan_xxxxxxxxxxxx
RAZORPAY_PLAN_AGENCY_ID=plan_xxxxxxxxxxxx
RAZORPAY_PLAN_SCALE_ID=plan_xxxxxxxxxxxx

# Resend (transactional email)
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=Zybble <hello@your-verified-domain.com>

# Public app URL used in emails + checkout returns (server-side)
APP_URL=https://your-production-domain.com
