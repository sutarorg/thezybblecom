# ============================================================================
# Zybble — environment template. Copy to .env.local and fill in your values.
# NEVER commit real keys. See README.md for the full setup walkthrough.
# ============================================================================

# ---------------------------------------------------------------------------
# 1) BROWSER-SAFE (Vite build-time variables)
#
# Vite inlines these into the client bundle at BUILD time. They configure the
# browser Supabase client only (src/app/services/supabase.ts).
#
# IMPORTANT: a VITE_ prefix NEVER satisfies the server-side process.env.*
# lookups below. Setting VITE_SUPABASE_URL does not configure /api/search-run;
# the Vercel Functions read the separate SUPABASE_* variables in section 2.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Paddle Billing in the BROWSER — the client-side token is intentionally
# public: it can only open checkouts for this Paddle account's prices, it can
# never read or change subscriptions. Get it at Paddle → Developer tools →
# Authentication → Client-side tokens. Sandbox tokens start test_…, live
# tokens live_… .
VITE_PADDLE_CLIENT_TOKEN=test_xxxxxxxx
# Which environment Paddle.js loads: "sandbox" or "production". If omitted,
# it is derived from the token prefix (test_ → sandbox, live_ → production).
# This must match the server's PADDLE_ENVIRONMENT.
VITE_PADDLE_ENVIRONMENT=sandbox

# ---------------------------------------------------------------------------
# 2) VERCEL / SERVER-SIDE (Node runtime of the Vercel Functions)
#
# Read via process.env by api/search-run.ts, api/ai-interpret.ts,
# api/ai-analyze.ts, api/export-run.ts, api/team-invite.ts, and api/billing.ts
# (see api/_lib/supabase-server.ts).
# These are runtime variables, NOT build variables — never prefix with VITE_,
# and never move server secrets into the VITE_ section above.
#
# Set them in Vercel → Project → Settings → Environment Variables for
# Production, Preview, AND Development, then REDEPLOY: existing deployments
# do not receive new values retroactively.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# Optional backwards-compatibility fallback: used only when
# SUPABASE_PUBLISHABLE_KEY is absent (legacy projects used the anon JWT key).
# Do NOT put a service-role / secret key here — the user-scoped API routes
# reject it so row-level security is never bypassed.
SUPABASE_ANON_KEY=

# Billing is the only Vercel API route that needs Supabase write access, because
# it persists Paddle subscription ids/statuses after authenticating the
# caller. Keep this server-only; never prefix with VITE_ and never expose it in
# the browser.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxx

# ---------------------------------------------------------------------------
# 3) PROVIDERS (server-side only on Vercel; never prefix with VITE_)
#
# Set on Vercel for the /api routes, and additionally as Supabase Edge
# Function secrets (`supabase secrets set …`) for the non-Vercel fallback.
# ---------------------------------------------------------------------------

# Business search — used by /api/search-run and the search-run Edge Function.
SERPAPI_API_KEY=your_rotated_serpapi_key

# AI — DeepSeek V3.2 via OpenRouter's server-side API. Powers ALL AI surfaces:
# lead analysis (/leads/:id), request interpretation (/find), and the
# Ask Zybble landing-page assistant. Used by /api/ai-analyze, /api/ai-interpret,
# /api/ai-chat and the ai-analyze / ai-interpret Edge Functions.
# Server-side only — the browser never sees this key and never talks to
# OpenRouter directly, so visitors are never asked to sign in to anything
# but Zybble. Create the key at https://openrouter.ai → Keys → Create key.
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxx
OPENROUTER_MODEL=deepseek/deepseek-v3.2
# Optional attribution headers sent with every OpenRouter request:
OPENROUTER_HTTP_REFERER=https://zybble.com
OPENROUTER_X_TITLE=Zybble

# Lead/contact forms — Web3Forms (https://web3forms.com). Used server-side by
# /api/ai-lead (Zybble AI's consent-based email capture). Web3Forms access
# keys are public-by-design (they can only submit to the inbox they were
# created for) — the same key powers the /contact form in the browser — but
# setting it here lets you rotate the key without a code change.
WEB3FORMS_ACCESS_KEY=05b0c5ca-dd84-41c9-9611-304238cb58de

# Transactional email — used by /api/team-invite and the Edge Functions.
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=Zybble <hello@your-verified-domain.com>

# Billing — Paddle Billing. Zybble's checkout is powered by Paddle.js in the
# browser (public CLIENT-side token, section 1) plus these SERVER-side
# credentials. Keep sandbox and live credentials matched: a test_ client token
# must be paired with the sandbox API key + sandbox price ids, a live_ token
# with the live ones. Paddle sandbox and live are never interchangeable.
# See README.md → "Paddle dashboard setup" for the click-by-click walkthrough.
#
# Server-side API key (Paddle → Developer tools → Authentication → API keys).
# Sandbox keys start pdl_srbx_sandbox_…, live keys pdl_srbx_live_… . NEVER
# prefix with VITE_ — this key can change subscriptions and must never be
# bundled into the browser.
PADDLE_API_KEY=pdl_srbx_sandbox_xxxxxxxx

# Webhook signing secret (Paddle → Developer tools → Notifications → your
# webhook destination → click the destination → Signature verification →
# "Webhook secret", format pdl_ntfset_…). Used by /api/paddle-webhook and the
# paddle-webhook Edge Function to verify the Paddle-Signature header over the
# RAW request body. Server-side only.
PADDLE_WEBHOOK_SECRET=pdl_ntfset_xxxxxxxx

# Which Paddle environment the SERVER talks to: "sandbox" or "production"
# (anything other than "sandbox" is treated as production). This must match
# the environment your VITE_PADDLE_CLIENT_TOKEN belongs to, or checkout
# refuses to open rather than mixing sandbox and live credentials.
# Optional — defaults to production.
PADDLE_ENVIRONMENT=sandbox

# The Paddle price id (starts with pri_) for each paid plan's MONTHLY price
# ($49 Growth / $99 Agency / $199 Scale). These are server-side so the browser
# can never pick an arbitrary price: the checkout action resolves the plan →
# price mapping here and returns only the one public price id for the plan
# being purchased. Prices are per environment — sandbox price ids differ from
# live ones. Create them at Paddle → Catalog → Products → Zybble subscription
# → click each price and copy the pri_… id.
PADDLE_PRICE_GROWTH_ID=pri_xxxxxxxxxxxx
PADDLE_PRICE_AGENCY_ID=pri_xxxxxxxxxxxx
PADDLE_PRICE_SCALE_ID=pri_xxxxxxxxxxxx

# Public app URL used in emails + checkout returns (server-side).
APP_URL=https://your-production-domain.com

# ---------------------------------------------------------------------------
# 4) SUPABASE EDGE FUNCTION SECRETS (set via `supabase secrets set`, not Vercel)
#
# The Supabase runtime injects SUPABASE_URL and SUPABASE_SECRET_KEYS
# automatically when the function runs — never set those yourself. Everything
# below must be configured manually with the Supabase CLI:
#
#   supabase secrets set \
#     SERPAPI_API_KEY=… OPENROUTER_API_KEY=sk-or-… OPENROUTER_MODEL=deepseek/deepseek-v3.2 \
#     PADDLE_API_KEY=… PADDLE_WEBHOOK_SECRET=… PADDLE_ENVIRONMENT=sandbox \
#     PADDLE_PRICE_GROWTH_ID=pri_… PADDLE_PRICE_AGENCY_ID=pri_… PADDLE_PRICE_SCALE_ID=pri_… \
#     RESEND_API_KEY=… RESEND_FROM_EMAIL="Zybble <hello@your-domain.com>" \
#     APP_URL="https://your-domain.com"
#
#   supabase functions deploy search-run ai-interpret ai-analyze export-run \
#     team-invite billing paddle-webhook
# ---------------------------------------------------------------------------
# The Paddle variables above are intentionally listed in section 3 because
# /api/billing and /api/paddle-webhook use them on Vercel. Set those same names
# as Supabase secrets too if you use the Edge Function fallback (billing) and
# the paddle-webhook Edge Function.
