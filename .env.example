# ============================================================================
# Zybble — environment template. Copy to .env.local and fill in your values.
# NEVER commit real keys. See README.md for the full setup walkthrough.
# ============================================================================

# ---------------------------------------------------------------------------
# 1) BROWSER-SAFE (Vite build-time variables)
#
# Vite inlines these into the client bundle at BUILD time. They configure the
# browser Supabase client only (src/app/services/supabase.ts).
#
# IMPORTANT: a VITE_ prefix NEVER satisfies the server-side process.env.*
# lookups below. Setting VITE_SUPABASE_URL does not configure /api/search-run;
# the Vercel Functions read the separate SUPABASE_* variables in section 2.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# ---------------------------------------------------------------------------
# 2) VERCEL / SERVER-SIDE (Node runtime of the Vercel Functions)
#
# Read via process.env by api/search-run.ts, api/ai-interpret.ts,
# api/ai-analyze.ts, api/export-run.ts, and api/team-invite.ts
# (see api/_lib/supabase-server.ts).
# These are runtime variables, NOT build variables — never prefix with VITE_,
# and never move server secrets into the VITE_ section above.
#
# Set them in Vercel → Project → Settings → Environment Variables for
# Production, Preview, AND Development, then REDEPLOY: existing deployments
# do not receive new values retroactively.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# Optional backwards-compatibility fallback: used only when
# SUPABASE_PUBLISHABLE_KEY is absent (legacy projects used the anon JWT key).
# Do NOT put a service-role / secret key here — the API routes reject it so
# row-level security is never bypassed.
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# 3) PROVIDERS (server-side only on Vercel; never prefix with VITE_)
#
# Set on Vercel for the /api routes, and additionally as Supabase Edge
# Function secrets (`supabase secrets set …`) for the non-Vercel fallback.
# ---------------------------------------------------------------------------

# Business search — used by /api/search-run and the search-run Edge Function.
SERPAPI_API_KEY=your_rotated_serpapi_key

# AI — DeepSeek V3.2 via OpenRouter's server-side API. Powers ALL AI surfaces:
# lead analysis (/leads/:id), request interpretation (/find), and the
# Ask Zybble landing-page assistant. Used by /api/ai-analyze, /api/ai-interpret,
# /api/ai-chat and the ai-analyze / ai-interpret Edge Functions.
# Server-side only — the browser never sees this key and never talks to
# OpenRouter directly, so visitors are never asked to sign in to anything
# but Zybble. Create the key at https://openrouter.ai → Keys → Create key.
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxx
OPENROUTER_MODEL=deepseek/deepseek-v3.2
# Optional attribution headers sent with every OpenRouter request:
OPENROUTER_HTTP_REFERER=https://zybble.com
OPENROUTER_X_TITLE=Zybble

# Transactional email — used by /api/team-invite and the Edge Functions.
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=Zybble <hello@your-verified-domain.com>

# Public app URL used in emails + checkout returns (server-side).
APP_URL=https://your-production-domain.com

# ---------------------------------------------------------------------------
# 4) SUPABASE EDGE FUNCTION SECRETS (set via `supabase secrets set`, not Vercel)
#
# The Supabase runtime injects SUPABASE_URL and SUPABASE_SECRET_KEYS
# automatically when the function runs — never set those yourself. Everything
# below must be configured manually with the Supabase CLI:
#
#   supabase secrets set \
#     SERPAPI_API_KEY=… OPENROUTER_API_KEY=sk-or-… OPENROUTER_MODEL=deepseek/deepseek-v3.2 \
#     RAZORPAY_KEY_ID=… RAZORPAY_KEY_SECRET=… RAZORPAY_WEBHOOK_SECRET=… \
#     RAZORPAY_PLAN_GROWTH_ID=… RAZORPAY_PLAN_AGENCY_ID=… RAZORPAY_PLAN_SCALE_ID=… \
#     RESEND_API_KEY=… RESEND_FROM_EMAIL="Zybble <hello@your-domain.com>" \
#     APP_URL="https://your-domain.com"
#
#   supabase functions deploy search-run ai-interpret ai-analyze export-run \
#     team-invite billing razorpay-webhook
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_signing_secret
RAZORPAY_PLAN_GROWTH_ID=plan_xxxxxxxxxxxx
RAZORPAY_PLAN_AGENCY_ID=plan_xxxxxxxxxxxx
RAZORPAY_PLAN_SCALE_ID=plan_xxxxxxxxxxxx
